   "name": "grill",
   "description": "Grill the user about an idea or plan, one question at a time with a recommended answer, until you share an understanding of the design. Use before writing a plan or spec for anything above a one-line fix.",
   "path": "skills/grill/SKILL.md",
   "install": "npx skills add <owner>/<repo> --skill grill"
  },
  {
   "name": "guide",
   "description": "Route an agent-orchestration request to the claude-guides playbook and load only the sections it needs. Use for starting from a vague idea, a new feature, bug fix, refactor or migration, setting up a harness or hooks, code review by an agent, an overnight loop, a stuck or looping agent, a cost blowup, multi-repo or parallel work, onboarding a repo, writing an agent-ready issue, or a retro.",
   "path": "skills/guide/SKILL.md",
   "install": "npx skills add <owner>/<repo> --skill guide"
  },
  {
   "name": "prompt",
   "description": "Turn a description or scenario into a ready-to-run prompt for Claude agents, built from the claude-guides playbook's templates. Use when you need a task prompt, a goal with done-when checks, a plan request, helper briefs and a synthesis step for sub-agents, or a loop or schedule prompt.",
   "path": "skills/prompt/SKILL.md",
   "install": "npx skills add <owner>/<repo> --skill prompt"
  }
